# Server Configuration
PORT=3000
HOST=0.0.0.0

# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Social Media API Keys (optional - will be requested from user)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TWITTER_API_KEY=
TWITTER_API_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Database (for future use)
DATABASE_URL=sqlite:./data/socio_agent.db

# Logging
RUST_LOG=info
